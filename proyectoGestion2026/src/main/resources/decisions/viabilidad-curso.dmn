<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="reglasCursos" name="Reglas para organizar cursos" namespace="proyecto.cursos">
  <decision id="viabilidadCurso" name="Viabilidad del curso">
    <decisionTable id="tablaViabilidad" hitPolicy="UNIQUE">
      <input id="entradaCantidad" label="Otras instancias sin finalizar">
        <inputExpression id="expCantidad" typeRef="number"><text>cantidadOtrosCursos</text></inputExpression>
      </input>
      <output id="salidaViable" name="viable" typeRef="boolean"/>
      <rule id="continuar">
        <inputEntry id="menosDeCinco"><text>&lt; 5</text></inputEntry>
        <outputEntry id="esViable"><text>true</text></outputEntry>
      </rule>
      <rule id="notificar">
        <inputEntry id="cincoOMas"><text>&gt;= 5</text></inputEntry>
        <outputEntry id="noEsViable"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
